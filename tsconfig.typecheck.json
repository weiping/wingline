{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "allowImportingTsExtensions": false,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "@weiping/wingline-core": [
        "./packages/core/src/index.ts"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "test",
    "spikes",
    "vitest.config.ts"
  ]
}
