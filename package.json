{
  "name": "wingline-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -b packages/core packages/cli && pnpm --filter @wingline/web build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
