{
  "manifestVersion": 2,
  "id": "wingline",
  "name": "Wingline",
  "version": "0.1.0",
  "description": "雁阵 Wingline 的 Orca 侧栏控制台：团队、收件箱、任务与岗位的一处视图。",
  "engines": { "orca": ">=1.4.246" },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      { "id": "wingline", "title": "Wingline", "icon": "blocks", "entry": "src/panel.tsx", "ui": "components" }
    ]
  },
  "capabilities": [
    { "kind": "storage:own" },
    { "kind": "settings:own" },
    { "kind": "workspace:read" }
  ]
}
