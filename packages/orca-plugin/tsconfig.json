{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "paths": {
      "orca": [
        "./types/orca.d.ts"
      ],
      "orca/worker": [
        "./types/orca-worker.d.ts"
      ],
      "orca/testing": [
        "./types/orca-testing.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "types"
  ]
}
